# ==============================================================
# ASPPIBRA DAO - MONOREPO CONFIGURATIONS
# This is a root .env.example. Do not put real secrets here!
# ==============================================================

# --------------------------------------------------------------
# 📦 CLOUDFLARE R2 (CDN & PUBLIC ASSETS)
# --------------------------------------------------------------
NEXT_PUBLIC_ASSET_PREFIX=https://pub-[ID].r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-[ID].r2.dev
NEXT_PUBLIC_R2_BUCKET_NAME=socialfi
R2_ENDPOINT=https://[ID].r2.cloudflarestorage.com

# --------------------------------------------------------------
# 🌐 API & SITE CONNECTIVITY
# --------------------------------------------------------------
NEXT_PUBLIC_HOST_API=https://api.asppibra.com
NEXT_PUBLIC_SITE_URL=https://www.asppibra.com
VITE_SERVER_URL=https://api.asppibra.com
VITE_ASSETS_DIR=

# --------------------------------------------------------------
# 🏛️ DATABASE (NEON POSTGRESQL) - SECRETS (Backend Only)
# --------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host-pooler/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/neondb?sslmode=require"
PGHOST="host"
PGDATABASE="neondb"
PGUSER="user"
PGPASSWORD="password"

# --------------------------------------------------------------
# ⚡ STORAGE, EDGE & CACHE - SECRETS (Backend Only)
# --------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
EDGE_CONFIG="https://edge-config.vercel.com/..."
REDIS_URL="redis://default:pass@host"
VERCEL_OIDC_TOKEN="eyJhbGciOi..."
GROQ_API_KEY="gsk_..."
